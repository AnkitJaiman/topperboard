# ---- Database (Supabase > Project Settings > Database > Connection string > "Transaction pooler", port 6543) ----
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---- Razorpay (Dashboard > Account & Settings > API Keys) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay > Webhooks > secret you choose (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ---- Admin panel (/admin) ----
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string (used to sign the admin login cookie and hash visitor IDs)
APP_SECRET=choose-another-long-random-string

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://topperboard.in
